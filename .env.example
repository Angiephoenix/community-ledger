# Community Ledger · configuration NAMES only. Never commit real values.
# docs/CONNECTED-SYSTEM.md explains each one: where it belongs and whether it is
# public or secret. Put values in your secure environment settings, never in
# chat, issues or commits.

# ---- Browser build (public: shipped to every visitor's browser)
VITE_APP_MODE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_FUNCTIONS_URL=
VITE_POSTHOG_HOST=
VITE_POSTHOG_PROJECT_KEY=

# ---- Edge Function secrets (set with `supabase secrets set`; server only)
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS are provided
# by the Supabase platform automatically. Do not set them yourself.
APP_ORIGIN=
PAYMENT_PROVIDER=
PAYSTACK_SECRET_KEY=
POSTHOG_HOST=
POSTHOG_PROJECT_KEY=

# ---- Your machine only (scripts; never deployed)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_CRON_KEY=
TEST_USER_PASSWORD=
TEST_USER_EMAIL_DOMAIN=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_APP_HOST=
